#
# Variables de entorno para la ejecución de los tests
#
# NOTE: no están todas las variables acá. Se pueden ver en cada test.
#
# Este archivo se debe copiar a test.env y ahí editar.
#

# Autenticación en API Gateway
APIGATEWAY_API_URL="https://app.apigateway.cl"
APIGATEWAY_API_TOKEN=""

# Contribuyente de primera categoría
TEST_CONTRIBUYENTE_RUT=""
TEST_CONTRIBUYENTE_IDENTIFICADOR=""
TEST_CONTRIBUYENTE_CLAVE=""

TEST_PERIODO=""

# Contribuyente de 2da categoría (y usuario Portal MIPYME)
TEST_USUARIO_RUT=""
TEST_USUARIO_IDENTIFICADOR=""
TEST_USUARIO_CLAVE=""

# Contribuyente de primera categoría que usa el software del SII para facturar
TEST_PORTAL_MIPYME_CONTRIBUYENTE_RUT=""

# Certificado digital en PEM. Lo exigen todo el CAF, RTC/Cesiones y
# varios recursos de DTE/Contribuyentes. Se obtiene desde el .p12 o
# .pfx siguiendo https://www.apigateway.cl/docs/tutoriales/extraer-pem
# que deja el certificado y la llave en cert-data.txt y pkey-data.txt.
# Acepta el contenido pegado o la ruta al archivo.
TEST_CERT_DATA=""
TEST_PKEY_DATA=""

# Alternativa: la firma completa en base64 (archivo .p12/.pfx) y su
# contraseña. Es lo que usan los tests que exigen certificado.
TEST_FIRMA_ELECTRONICA=""
TEST_FIRMA_CLAVE=""

# DTE/Contribuyentes
# RUN al que se le asignarán permisos (test `risky` de set_usuario).
TEST_DTE_USUARIO_RUN=""
# En 1 habilita la descarga masiva de contribuyentes autorizados:
# cientos de MB y hasta 15 minutos.
TEST_DTE_AUTORIZADOS=0

# RCV: documentos en el mismo JSON que recibe la API. Sin estas
# variables los tests `risky` de escritura se omiten.
# [{"emisor": "77666555-4", "dte": 33, "folio": 1, "tipo_transaccion": 1, "codigo_iva": 1}]
TEST_RCV_COMPRAS_DOCUMENTOS=""
# [{"det_tipo_doc": 39, "det_nro_doc": 10, "det_mnt_neto": 10000, "det_mnt_iva": 1900, "det_mnt_exe": 0, "det_mnt_total": 11900}]
TEST_RCV_VENTAS_DOCUMENTOS=""

# CAF
TEST_CAF_DTE=33
# Datos de un CAF ya solicitado (estados y descarga del XML)
TEST_CAF_FOLIO=""
TEST_CAF_FOLIO_INICIAL=""
TEST_CAF_FOLIO_FINAL=""
TEST_CAF_FECHA_AUTORIZACION=""
# "recibidos", "anulados" o "pendientes"
TEST_CAF_ESTADO="recibidos"
# Cantidad de folios a timbrar (test `risky` de solicitar)
TEST_CAF_CANTIDAD=""
# Rango a anular (test `risky`, irreversible en el SII)
TEST_CAF_ANULAR_INICIAL=""
TEST_CAF_ANULAR_FINAL=""

# Previred (recurso público; el período por defecto ya está publicado)
TEST_PREVIRED_PERIODO=202501

# Indicadores públicos: el año/período por defecto ya está publicado,
# así que los tests son deterministas.
TEST_CORRECCION_MONETARIA_ANIO=2024
TEST_IMPUESTO_2DA_ANIO=2024
TEST_IMPUESTO_2DA_PERIODO=202410

# Vehículos (recurso público). `categoria` y `tipo` son obligatorios
# para buscar(); los IDs salen de categorias_tipos()/categorias_marcas().
TEST_VEHICULOS_CATEGORIA=1
TEST_VEHICULOS_TIPO=6
# buscar() sólo con categoría y tipo es inestable en el SII;
# acotar con marca y año la hace reproducible.
TEST_VEHICULOS_MARCA=229
TEST_VEHICULOS_ANIO=2020

# Bienes raíces (recurso público). El rol por defecto existe y sirve
# para CI; el EAC lo deriva el test desde la consulta por rol.
TEST_BIENES_RAICES_COMUNA=13101
TEST_BIENES_RAICES_MANZANA=1
TEST_BIENES_RAICES_PREDIO=1
TEST_BIENES_RAICES_NOMBRE_COMUNA="SANTIAGO"

# F29 (el folio lo deriva el test desde el listado de declaraciones)
TEST_F29_ANIO=""

# MiSii: representar() cambia a nombre de quién actúa la sesión
TEST_MISII_REPRESENTAR_RUT=""
TEST_MISII_REPRESENTAR_PERMISOS=""

# BTE
TEST_BTE_ANIO=""

# DTE: track id de un envío real de XML al SII
TEST_DTE_TRACK_ID=""

# IECV: sólo períodos de 201707 hacia atrás
TEST_IECV_PERIODO=""
TEST_IECV_TRACK_ID=""
TEST_IECV_OPERACION="VENTA"
TEST_IECV_TIPO="MENSUAL"

# RTC (cesiones). El período admite un mes como máximo.
# consulta: 0 deudor, 1 cedente, 2 cesionario.
TEST_RTC_DESDE=""
TEST_RTC_HASTA=""
TEST_RTC_CONSULTA=0
TEST_RTC_TRACK_ID=""

# Portal MIPYME - borradores
TEST_MIPYME_BORRADOR_CODIGO=""
# JSON del DTE a armar como borrador (test `risky`)
TEST_MIPYME_BORRADOR_DTE=""
# Código del borrador a eliminar (test `risky`)
TEST_MIPYME_BORRADOR_ELIMINAR=""

# eBoleta: el contribuyente va sin puntos ni dígito verificador
TEST_EBOLETA_CONTRIBUYENTE=""
TEST_EBOLETA_DESDE=""
TEST_EBOLETA_HASTA=""
# JSON de la boleta a emitir (test `risky`, emite ante el SII)
TEST_EBOLETA_DTE=""
# Destino del correo (test `risky`, envía un correo real)
TEST_EBOLETA_EMAIL=""

# BHE - consulta por terceros: código de barras impreso en la boleta
TEST_BHE_TERCEROS_CODIGO_BARRAS=""

# Anulaciones: IRREVERSIBLES en el SII. Los tests `risky` que anulan
# exigen el folio exacto; sin estas variables se omiten y nunca eligen
# una boleta por su cuenta.
TEST_BHE_ANULAR_FOLIO=""
TEST_BTE_ANULAR_FOLIO=""

# Credenciales por defecto para probar.py, así no hay que repetirlas
# en cada comando. Si no están, usa TEST_CONTRIBUYENTE_* y, para los
# recursos que exigen certificado, TEST_FIRMA_ELECTRONICA/_CLAVE.
PROBAR_RUT=""
PROBAR_CLAVE=""
PROBAR_PEM_CERT=""
PROBAR_PEM_KEY=""

TEST_VERBOSE = 0
